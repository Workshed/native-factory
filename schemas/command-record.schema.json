{
  "$id": "https://native-factory.dev/schemas/command-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One factory-invoked command.\n\nOnly factory-invoked commands are recorded. Commands the coding agent runs in its own\ninner loop are deliberately not here -- see ADR-0004.\n\nGenerated from pydantic models by native_factory_core.schema.export -- do not edit.",
  "properties": {
    "argv": {
      "items": {
        "type": "string"
      },
      "title": "Argv",
      "type": "array"
    },
    "duration_ms": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Ms"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "stage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stage"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "vm_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vm Name"
    }
  },
  "required": [
    "run_id",
    "argv"
  ],
  "title": "CommandRecord",
  "type": "object"
}
